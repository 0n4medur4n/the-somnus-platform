# Copy to backend.hcl (gitignored) and fill in your GCS state bucket, then:
#   terraform init -backend-config=backend.hcl
#
# The bucket must already exist with object versioning and uniform bucket-level
# access enabled, in europe-west3, readable/writable only by the CI service
# account and infra admins. Keep production state in its OWN bucket, separate
# from staging, so a staging mistake can never touch production state. `prefix`
# is already set in versions.tf.
bucket = "the-somnus-tfstate-production"

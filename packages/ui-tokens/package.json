{
  "name": "@somnus/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Product UI tokens shared by The Somnus SPAs (colors, type, Tailwind spacing and radius). Marketing brand tokens stay in @somnus/design-system.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@somnus/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

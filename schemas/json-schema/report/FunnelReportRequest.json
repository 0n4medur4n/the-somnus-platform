{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    },
    "completedAt": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "template",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "declined",
              "incomplete",
              "pending_file"
            ]
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "placement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "name",
          "status",
          "total",
          "band",
          "placement"
        ],
        "additionalProperties": false
      }
    },
    "instrumentsNote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "enum": [
                "urgent",
                "standard"
              ]
            },
            "headline": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "help": {
              "type": "object",
              "properties": {
                "sentences": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "code",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sentences",
                "resources"
              ],
              "additionalProperties": false
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "professional": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "mainAction": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "associatedActions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "templates": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reasons": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "reasons"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "alerts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "pendingData": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "safety": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "question": {
                            "type": "string",
                            "minLength": 1
                          },
                          "answer": {
                            "type": "string"
                          },
                          "when": {
                            "type": "string",
                            "enum": [
                              "moment",
                              "end",
                              "confirmed"
                            ]
                          }
                        },
                        "required": [
                          "question",
                          "answer",
                          "when"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "answers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "question": {
                            "type": "string",
                            "minLength": 1
                          },
                          "answer": {
                            "type": "string"
                          },
                          "origin": {
                            "type": "string",
                            "enum": [
                              "answered",
                              "narrative",
                              "corrected"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "question",
                          "answer",
                          "origin"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "narrative": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "grounding": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "sourceIds": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "queries": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "required": [
                            "sourceIds",
                            "queries"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "mainAction",
                    "associatedActions",
                    "templates",
                    "rules",
                    "flags",
                    "alerts",
                    "pendingData",
                    "safety",
                    "answers",
                    "narrative"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "layout",
            "headline",
            "secondary",
            "summary",
            "steps",
            "help",
            "limits",
            "sources",
            "professional"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sessionId",
    "locale",
    "completedAt",
    "contentVersion",
    "rulesVersion",
    "texts",
    "instruments",
    "instrumentsNote"
  ],
  "additionalProperties": false
}

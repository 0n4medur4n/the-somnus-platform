{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    },
    "completedAt": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "template",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "declined",
              "incomplete",
              "pending_file"
            ]
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "band": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "placement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "name",
          "status",
          "total",
          "band",
          "placement"
        ],
        "additionalProperties": false
      }
    },
    "instrumentsNote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sessionId",
    "locale",
    "completedAt",
    "contentVersion",
    "rulesVersion",
    "texts",
    "instruments",
    "instrumentsNote"
  ],
  "additionalProperties": false
}

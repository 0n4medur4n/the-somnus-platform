{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1
    },
    "definitionVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "htmlUrl": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "pdfUrl": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reportId",
    "assessmentId",
    "templateVersion",
    "definitionVersion",
    "contentVersion",
    "locale",
    "createdAt",
    "htmlUrl",
    "pdfUrl"
  ],
  "additionalProperties": false
}

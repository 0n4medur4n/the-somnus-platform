{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "passages": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "lang": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    }
  },
  "required": [
    "passages",
    "lang"
  ],
  "additionalProperties": false
}

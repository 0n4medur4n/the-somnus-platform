{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    },
    "generated": {
      "type": "boolean"
    },
    "narrative": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 900
            },
            "whatToDo": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "patterns": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  }
                },
                "required": [
                  "name",
                  "why"
                ],
                "additionalProperties": false
              }
            },
            "recommendations": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prepare": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "summary",
            "whatToDo",
            "patterns",
            "recommendations",
            "prepare"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "assessmentId",
    "locale",
    "generated"
  ],
  "additionalProperties": false
}

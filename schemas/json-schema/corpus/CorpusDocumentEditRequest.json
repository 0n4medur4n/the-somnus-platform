{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "citation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceType": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "locale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "rightsStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "own_document",
            "open_access",
            "licensed",
            "citation_only"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rightsEvidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "licence": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "holder": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "scopes": {
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scopeType": {
                "type": "string",
                "enum": [
                  "module",
                  "safety_rule",
                  "clinical_source",
                  "general"
                ]
              },
              "scopeKey": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "scopeType",
              "scopeKey"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}

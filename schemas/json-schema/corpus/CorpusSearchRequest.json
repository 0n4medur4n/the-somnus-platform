{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "retired"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "locale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "module",
            "safety_rule",
            "clinical_source",
            "general"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeKey": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}

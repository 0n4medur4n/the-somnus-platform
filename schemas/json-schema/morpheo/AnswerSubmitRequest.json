{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "complaint",
        "signal"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "additionalProperties": false
}

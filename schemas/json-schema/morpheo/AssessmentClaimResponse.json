{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "snapshotId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "already_claimed_or_expired"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "success",
    "snapshotId",
    "reason"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "started": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byStatus": {
      "type": "object",
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stopped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "open",
        "finished",
        "stopped",
        "paused"
      ],
      "additionalProperties": false
    },
    "closed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byMainAction": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "byTemplate": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "byAlert": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "withAlerts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byMonth": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "started": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "closed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "month",
          "started",
          "closed"
        ],
        "additionalProperties": false
      }
    },
    "firstStartedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastStartedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "started",
    "byStatus",
    "closed",
    "byMainAction",
    "byTemplate",
    "byAlert",
    "withAlerts",
    "byMonth",
    "firstStartedAt",
    "lastStartedAt"
  ],
  "additionalProperties": false
}

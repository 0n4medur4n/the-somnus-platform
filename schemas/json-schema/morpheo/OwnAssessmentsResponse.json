{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "adult",
              "parent",
              "professional"
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "L0",
                  "L1",
                  "L2",
                  "L3",
                  "L4"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "stop": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "sessionId",
          "role",
          "level",
          "stop",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assessments"
  ],
  "additionalProperties": false
}

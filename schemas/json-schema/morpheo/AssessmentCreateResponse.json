{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "sessionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "privacy_block",
            "consent_required",
            "ineligible"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "allowed",
    "sessionId",
    "reason"
  ],
  "additionalProperties": false
}

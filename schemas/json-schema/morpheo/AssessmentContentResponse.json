{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "ca",
        "fr"
      ]
    },
    "workflowVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "INS",
              "BRE",
              "SLP",
              "CIR",
              "RLS",
              "PAR"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimumQuestions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "entry",
          "minimumQuestions",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "safetyLevels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "safetyPrompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signalId": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "enum": [
              "general",
              "pediatric"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "signalId",
          "context",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "limitsText": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockedClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputContract": {
      "type": "object",
      "properties": {
        "patientParent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "professional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "patientParent",
        "professional",
        "forbiddenPhrases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "locale",
    "workflowVersion",
    "contentVersion",
    "modules",
    "safetyLevels",
    "safetyPrompts",
    "limitsText",
    "blockedClaims",
    "outputContract"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "value": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "absence": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "no_lo_se",
            "prefiero_no_responder"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key"
  ],
  "additionalProperties": false
}

---
import CtaButton from "../../components/CtaButton";
import { HeroLightfall } from "../../components/HeroLightfall";
import { GabaHero } from "../../components/gaba/GabaHero";
import type { GabaBackgroundCopy } from "../../components/gaba/gaba.types";
import { SectionIndex } from "../../components/SectionIndex";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALES, localizedPath, t } from "../../i18n/ui";
import { FocusText } from "../../components/ui/focus-text";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

type Locale = (typeof LOCALES)[number];
const { locale } = Astro.params as { locale: Locale };

const APP_URL = "https://the-somnus-app.web.app/";
const MORPHEO_URL = localizedPath(locale, "/morpheo/");
const resultKeys = ["1", "2", "3", "4", "5"] as const;
const transformationKeys = ["1", "2", "3", "4"] as const;
const stepKeys = ["1", "2", "3"] as const;
const trustKeys = ["1", "2", "3", "4"] as const;
const gabaCopy = {
  moleculeTitle: t(locale, "gaba.molecule.title"),
  moleculeDescription: t(locale, "gaba.molecule.description"),
  signalLabels: [
    t(locale, "gaba.signal.1"),
    t(locale, "gaba.signal.2"),
    t(locale, "gaba.signal.3"),
    t(locale, "gaba.signal.4"),
    t(locale, "gaba.signal.5"),
  ],
} satisfies GabaBackgroundCopy;
const sectionIndexItems = [
  { id: "recognition", label: t(locale, "story.index.recognition") },
  { id: "morpheo", label: t(locale, "story.index.morpheo") },
  { id: "transformation", label: t(locale, "story.index.transformation") },
  { id: "steps", label: t(locale, "story.index.steps") },
  { id: "trust", label: t(locale, "story.index.trust") },
  { id: "professional", label: t(locale, "story.index.professional") },
  { id: "final", label: t(locale, "story.index.final") },
];
---

<BaseLayout
  locale={locale}
  path="/"
  title={t(locale, "site.name")}
  description={t(locale, "story.hero.description")}
>
  <SectionIndex client:load ariaLabel={t(locale, "story.index.navigation")} items={sectionIndexItems} />
  <section class="story-hero">
    <div aria-hidden="true" class="story-hero__lightfall"><HeroLightfall client:load /></div>
    <div class="story-hero__copy">
      <span class="story-eyebrow">{t(locale, "story.hero.eyebrow")}</span>
      <h1>{t(locale, "story.hero.title")}</h1>
      <div class="story-hero__body">
        <p>{t(locale, "story.hero.body1")}</p>
        <p>{t(locale, "story.hero.body2")}</p>
      </div>
      <div class="story-actions">
        <CtaButton client:load href={MORPHEO_URL} label={t(locale, "story.hero.cta")} />
        <a class="story-secondary-link" href={APP_URL}>
          <span>{t(locale, "story.hero.secondaryCta")}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
      <p class="story-microcopy">{t(locale, "story.hero.microcopy")}</p>
    </div>

  </section>

  <GabaHero client:load copy={gabaCopy} />

  <section id="recognition" class="story-section story-section--recognition">
    <div class="story-section__intro story-section__intro--narrow">
      <FocusText client:load as="span" className="story-section__index">01</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.recognition.title")}</FocusText>
      <FocusText client:load as="p">{t(locale, "story.recognition.body")}</FocusText>
    </div>
    <div class="story-reflections">
      {transformationKeys.map((key, i) => (
        <FocusText client:load as="p" delay={i * 0.1}>{t(locale, `story.recognition.reflection${key}`)}</FocusText>
      ))}
    </div>
    <div class="story-transition">
      <span class="story-transition__line"></span>
      <FocusText client:load as="p">{t(locale, "story.recognition.transition")}</FocusText>
      <span class="story-transition__line"></span>
    </div>
    <div class="story-center-action">
      <CtaButton client:load href={APP_URL} label={t(locale, "story.recognition.cta")} />
    </div>
  </section>

  <section id="morpheo" class="story-section story-morpheo">
    <article class="story-morpheo__copy">
      <div class="story-morpheo__meta">
        <FocusText client:load as="span" className="story-eyebrow">{t(locale, "story.morpheo.eyebrow")}</FocusText>
        <FocusText client:load as="span" className="story-section__index">02</FocusText>
      </div>
      <FocusText client:load as="h2">{t(locale, "story.morpheo.title")}</FocusText>
      <FocusText client:load as="p">{t(locale, "story.morpheo.body")}</FocusText>
      <CtaButton client:load href={localizedPath(locale, "/morpheo")} label={t(locale, "story.morpheo.cta")} />
      <FocusText client:load as="p" className="story-microcopy">{t(locale, "story.morpheo.disclaimer")}</FocusText>
    </article>
    <article class="morpheo-result-card">
      <div class="morpheo-result-card__header">
        <FocusText client:load as="span">{t(locale, "site.product")}</FocusText>
        <span class="morpheo-result-card__status"></span>
      </div>
      <FocusText client:load as="h3">{t(locale, "story.morpheo.resultTitle")}</FocusText>
      <ul>
        {
          resultKeys.map((key, i) => (
            <li>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 3.2 3.2L16 4.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <FocusText client:load as="span" delay={i * 0.08}>{t(locale, `story.morpheo.result${key}`)}</FocusText>
            </li>
          ))
        }
      </ul>
    </article>
  </section>

  <section id="transformation" class="story-section story-section--transformation">
    <div class="story-section__intro">
      <FocusText client:load as="span" className="story-section__index">03</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.transformation.title")}</FocusText>
    </div>
    <div class="story-transformation-grid">
      <article class="transformation-card transformation-card--before">
        <FocusText client:load as="span">{t(locale, "story.transformation.beforeTitle")}</FocusText>
        <ul>{transformationKeys.map((key, i) => (
          <FocusText client:load as="li" delay={i * 0.08}>{t(locale, `story.transformation.before${key}`)}</FocusText>
        ))}</ul>
      </article>
      <div class="transformation-arrow" aria-hidden="true"><svg viewBox="0 0 36 36" fill="none"><path d="M5 18h24M20 9l9 9-9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
      <article class="transformation-card transformation-card--after">
        <FocusText client:load as="span">{t(locale, "story.transformation.afterTitle")}</FocusText>
        <ul>{transformationKeys.map((key, i) => (
          <FocusText client:load as="li" delay={i * 0.08}>{t(locale, `story.transformation.after${key}`)}</FocusText>
        ))}</ul>
      </article>
    </div>
    <FocusText client:load as="blockquote">{t(locale, "story.transformation.quote")}</FocusText>
    <div class="story-center-action"><CtaButton client:load href={APP_URL} label={t(locale, "story.transformation.cta")} /></div>
  </section>

  <section id="steps" class="story-section story-section--steps">
    <div class="story-section__intro">
      <FocusText client:load as="span" className="story-section__index">04</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.steps.title")}</FocusText>
      <FocusText client:load as="p">{t(locale, "story.steps.subtitle")}</FocusText>
    </div>
    <ol class="story-steps">
      {
        stepKeys.map((key, i) => (
          <li>
            <FocusText client:load as="span" className="story-steps__number" delay={i * 0.15}>0{key}</FocusText>
            <div>
              <FocusText client:load as="h3" delay={i * 0.15}>{t(locale, `story.steps.step${key}Title`)}</FocusText>
              <FocusText client:load as="p" delay={i * 0.15 + 0.05}>{t(locale, `story.steps.step${key}Body`)}</FocusText>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="story-center-action"><CtaButton client:load href={APP_URL} label={t(locale, "story.steps.cta")} /></div>
    <FocusText client:load as="p" className="story-microcopy story-microcopy--center">{t(locale, "story.steps.microcopy")}</FocusText>
  </section>

  <section id="trust" class="story-section story-section--trust">
    <div class="story-section__intro">
      <FocusText client:load as="span" className="story-section__index">05</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.trust.title")}</FocusText>
    </div>
    <div class="story-trust-grid">
      {
        trustKeys.map((key, i) => (
          <article>
            <FocusText client:load as="span" className="story-trust-grid__icon" delay={i * 0.1} aria-hidden="true">0{key}</FocusText>
            <FocusText client:load as="h3" delay={i * 0.1}>{t(locale, `story.trust.card${key}Title`)}</FocusText>
            <FocusText client:load as="p" delay={i * 0.1 + 0.05}>{t(locale, `story.trust.card${key}Body`)}</FocusText>
          </article>
        ))
      }
    </div>
  </section>

  <section id="professional" class="story-professional">
    <div>
      <FocusText client:load as="span" className="story-eyebrow">{t(locale, "story.professional.eyebrow")}</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.professional.title")}</FocusText>
      <FocusText client:load as="p">{t(locale, "story.professional.body")}</FocusText>
    </div>
    <a class="story-professional__link" href={APP_URL}>
      <span>{t(locale, "story.professional.cta")}</span>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </section>

  <section id="final" class="story-final">
    <div class="story-final__glow" aria-hidden="true"></div>
    <div class="story-final__content">
      <FocusText client:load as="span" className="story-section__index">06</FocusText>
      <FocusText client:load as="h2">{t(locale, "story.final.title")}</FocusText>
      <FocusText client:load as="p">{t(locale, "story.final.body")}</FocusText>
      <div class="story-center-action"><CtaButton client:load href={APP_URL} label={t(locale, "story.final.cta")} /></div>
      <FocusText client:load as="p" className="story-microcopy story-microcopy--center">{t(locale, "story.final.microcopy")}</FocusText>
    </div>
  </section>
</BaseLayout>

<style>
  .story-hero,
  .story-section,
  .story-professional,
  .story-final {
    position: relative;
    z-index: 1;
  }

  :global(.section-index) {
    position: fixed;
    z-index: 20;
    top: 50dvh;
    left: max(1.25rem, calc((100vw - 80rem) / 2 - 8.5rem));
    display: none;
    max-height: calc(100dvh - 8rem);
    transform: translate3d(0, -50%, 0);
  }

  :global(.section-index nav) {
    max-width: 9rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgba(111, 159, 255, 0.13);
    border-radius: 1rem;
    background: rgba(9, 13, 26, 0.76);
    box-shadow:
      8px 8px 18px rgba(0, 0, 0, 0.27),
      -4px -4px 12px rgba(255, 255, 255, 0.018),
      inset 1px 1px 0 rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  :global(.section-index nav ul) {
    max-height: calc(100dvh - 10rem);
    overflow-y: auto;
    scrollbar-width: none;
  }

  :global(.section-index nav ul::-webkit-scrollbar) { display: none; }

  .story-hero {
    --story-navbar-overlap: 6.35rem;

    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    gap: 3rem;
    width: 100vw;
    min-height: 100svh;
    margin-top: calc(-1 * var(--story-navbar-overlap));
    margin-inline: calc(50% - 50vw);
    padding: var(--story-navbar-overlap) 1.25rem 2rem;
    overflow: hidden;
    background: #090d1a;
    text-align: center;
  }

  .story-hero__copy {
    position: relative;
    z-index: 1;
    width: min(100%, 50rem);
    padding: clamp(1rem, 3vw, 2rem);
  }

  .story-hero__lightfall {
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
  }

  .story-hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 50% 44%, rgba(9, 13, 26, 0.04) 0 24%, rgba(9, 13, 26, 0.34) 64%, rgba(9, 13, 26, 0.78) 100%),
      linear-gradient(to bottom, transparent 48%, #090d1a 100%);
    content: "";
    pointer-events: none;
  }

  .story-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid rgba(67, 126, 247, 0.34);
    border-radius: 999px;
    background: rgba(67, 126, 247, 0.1);
    color: #9fc0ff;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .story-hero .story-eyebrow {
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .story-hero h1 {
    max-width: 12ch;
    margin: 1.15rem auto 0;
    color: var(--somnus-color-text);
    font-size: clamp(2.35rem, 6.6vw, 4.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .story-hero__body {
    display: grid;
    gap: 0.75rem;
    max-width: 37rem;
    margin: 1.6rem auto 0;
    color: #aebbd0;
    font-size: clamp(1rem, 2.2vw, 1.17rem);
    line-height: 1.7;
  }

  .story-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    justify-content: center;
  }

  .story-secondary-link,
  .story-professional__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.9rem;
    color: var(--somnus-color-text);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .story-secondary-link:hover,
  .story-professional__link:hover {
    color: #aecaFF;
  }

  .story-secondary-link svg,
  .story-professional__link svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .story-microcopy {
    margin-top: 0.95rem;
    color: var(--somnus-color-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    text-align: center;
  }

  .story-microcopy--center {
    text-align: center;
  }

  .story-section { padding: 5rem 0; }

  .story-section__intro { max-width: 44rem; }
  .story-section__intro--narrow { max-width: 39rem; }

  .story-section__index {
    display: inline-flex;
    margin-bottom: 0.8rem;
    color: var(--somnus-color-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .story-section h2,
  .story-professional h2,
  .story-final h2 {
    color: var(--somnus-color-text);
    font-size: clamp(2rem, 5vw, 3.55rem);
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .story-section__intro > p,
  .story-morpheo__copy > p,
  .story-professional p,
  .story-final p {
    margin-top: 1rem;
    color: #aebbd0;
    font-size: 1rem;
    line-height: 1.75;
  }

  .story-reflections {
    display: grid;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .story-reflections p {
    padding: 1rem 1.15rem;
    border: 1px solid rgba(226, 232, 240, 0.06);
    border-radius: 0.9rem;
    background: rgba(20, 28, 51, 0.68);
    box-shadow: 7px 7px 16px rgba(0, 0, 0, 0.25), -5px -5px 12px rgba(255, 255, 255, 0.02), inset 1px 1px 0 rgba(255, 255, 255, 0.025);
    color: #bdc9da;
    font-size: 0.96rem;
  }

  .story-transition {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 47rem;
    margin: 2.6rem auto 1.8rem;
    color: #d7e3f7;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  .story-transition__line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(67, 126, 247, 0.55), transparent); }
  .story-center-action { display: flex; justify-content: center; }

  .story-morpheo {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding: clamp(1rem, 2.5vw, 2.75rem);
    border: 1px solid rgba(226, 232, 240, 0.08);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgba(20, 28, 51, 0.92), rgba(9, 13, 26, 0.85));
    box-shadow:
      14px 14px 28px rgba(0, 0, 0, 0.38),
      -8px -8px 20px rgba(255, 255, 255, 0.025),
      inset 1px 1px 0 rgba(255, 255, 255, 0.04),
      inset -1px -1px 0 rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .story-morpheo:hover {
    border-color: rgba(67, 126, 247, 0.2);
    box-shadow:
      14px 14px 28px rgba(0, 0, 0, 0.4),
      -8px -8px 20px rgba(255, 255, 255, 0.03),
      inset 1px 1px 0 rgba(255, 255, 255, 0.05),
      inset -1px -1px 0 rgba(0, 0, 0, 0.2),
      0 0 40px rgba(67, 126, 247, 0.05);
  }

  .story-morpheo::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 30%, rgba(67, 126, 247, 0.06), transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .story-morpheo > * {
    position: relative;
    z-index: 1;
  }

  .story-morpheo__copy {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    max-width: none;
    padding: clamp(1.65rem, 3vw, 3rem);
    border: 1px solid rgba(111, 159, 255, 0.2);
    border-radius: 1.35rem;
    background:
      linear-gradient(145deg, rgba(29, 43, 76, 0.98), rgba(15, 23, 45, 0.97));
    box-shadow:
      16px 16px 32px rgba(0, 0, 0, 0.36),
      -9px -9px 22px rgba(108, 145, 217, 0.05),
      inset 1px 1px 0 rgba(255, 255, 255, 0.07),
      inset -4px -4px 10px rgba(3, 7, 17, 0.3);
    overflow: hidden;
  }

  .story-morpheo__copy::before {
    position: absolute;
    top: 0;
    left: 12%;
    width: 76%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(119, 164, 255, 0.75), transparent);
    content: "";
  }

  .story-morpheo__copy::after {
    position: absolute;
    top: -8rem;
    right: -7rem;
    width: 17rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(67, 126, 247, 0.18), transparent 68%);
    content: "";
    pointer-events: none;
  }

  .story-morpheo__meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(67, 126, 247, 0.2);
    border-radius: 0.7rem;
    background: rgba(9, 13, 26, 0.38);
    box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.24), inset -1px -1px 3px rgba(255, 255, 255, 0.025);
  }

  .story-morpheo__meta .story-eyebrow,
  .story-morpheo__meta .story-section__index {
    margin: 0;
  }

  .story-morpheo__copy h2 {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .story-morpheo__copy > p,
  .story-morpheo__copy > .cta-glow,
  .story-morpheo__copy .story-microcopy {
    position: relative;
    z-index: 1;
  }

  .story-morpheo__copy > .cta-glow { margin-top: 1.75rem; }
  .story-morpheo__copy .story-microcopy { text-align: left; }

  .morpheo-result-card {
    padding: 1.75rem;
    border: 1px solid rgba(226, 232, 240, 0.1);
    border-radius: 1.1rem;
    background: linear-gradient(145deg, rgba(20, 28, 51, 0.95), rgba(15, 20, 40, 0.9));
    box-shadow:
      10px 10px 22px rgba(0, 0, 0, 0.35),
      -6px -6px 16px rgba(255, 255, 255, 0.02),
      inset 2px 2px 4px rgba(255, 255, 255, 0.03),
      inset -2px -2px 4px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .morpheo-result-card:hover {
    border-color: rgba(67, 126, 247, 0.25);
    box-shadow:
      12px 12px 24px rgba(0, 0, 0, 0.4),
      -7px -7px 18px rgba(255, 255, 255, 0.025),
      inset 2px 2px 4px rgba(255, 255, 255, 0.04),
      inset -2px -2px 4px rgba(0, 0, 0, 0.18),
      0 0 30px rgba(67, 126, 247, 0.08);
    transform: translateY(-2px);
  }

  .morpheo-result-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(67, 126, 247, 0.4), transparent);
  }

  .morpheo-result-card__header { display: flex; align-items: center; justify-content: space-between; color: #aecaFF; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }

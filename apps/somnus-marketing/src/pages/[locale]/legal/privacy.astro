---
import LegalArticle from "../../../components/LegalArticle.astro";
import { LOCALES, t } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import privacyCa from "../../../../../../docs/legal/ca/privacy.md?raw";
import privacyEn from "../../../../../../docs/legal/en/privacy.md?raw";
import privacyEs from "../../../../../../docs/legal/es/privacy.md?raw";
import privacyFr from "../../../../../../docs/legal/fr/privacy.md?raw";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

type Locale = (typeof LOCALES)[number];
const { locale } = Astro.params as { locale: Locale };

const lastUpdated = t(locale, "legal.lastUpdated", { date: "2026-11-11" });
const markdown = { es: privacyEs, en: privacyEn, ca: privacyCa, fr: privacyFr }[locale];
---

<BaseLayout
  locale={locale}
  path="/legal/privacy"
  title={t(locale, "legal.privacy.title")}
  description={t(locale, "legal.privacy.body")}
>
  <article class="prose prose-invert mx-auto max-w-3xl py-16">
    <h1 class="font-display text-3xl text-text">{t(locale, "legal.privacy.title")}</h1>
    <p class="mt-2 text-sm text-muted">{lastUpdated}</p>
    <LegalArticle markdown={markdown} />
  </article>
</BaseLayout>

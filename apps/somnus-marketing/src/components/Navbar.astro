---
import logo from "../assets/logo/Logo.png";
import { LOCALE_NATIVE_NAMES, localizedPath, t, type Locale } from "../i18n/ui";

export interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;

const links: ReadonlyArray<{ href: string; icon: string; key: string }> = [
  {
    href: localizedPath(locale, "/"),
    key: "nav.home",
    icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>',
  },
  {
    href: localizedPath(locale, "/morpheo"),
    key: "site.product",
    icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8a8.5 8.5 0 1 0 11.3 11.3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="m16.8 4.2.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5.5-1.3Z" fill="currentColor"/></svg>',
  },
  {
    href: localizedPath(locale, "/pricing"),
    key: "nav.pricing",
    icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20a1 1 0 0 1 1 1v13.5A2.5 2.5 0 0 1 18.5 20H4V5.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 7h8M8 11h8M8 15h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  },
  {
    href: localizedPath(locale, "/legal/terms"),
    key: "nav.terms",
    icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v5h5M9 13h6M9 17h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  },
  {
    href: localizedPath(locale, "/legal/privacy"),
    key: "nav.privacy",
    icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.7 3 8.7 7 10 4-1.3 7-5.3 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9.5 12 1.7 1.7 3.5-3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
];

const locales = ["es", "en", "ca", "fr"] as const;
const currentPath = localizedPath(locale, path).replace(/\/$/, "");
const isActive = (href: string): boolean => href.replace(/\/$/, "") === currentPath;
const appUrl = "https://the-somnus-app.web.app/";
---

<header class="navbar" id="navbar">
  <div class="navbar__shell">
    <div class="navbar__inner">
      <a class="navbar__brand" href={localizedPath(locale, "/")} aria-label={t(locale, "site.name")}>
        <span class="navbar__brand-wordmark" aria-hidden="true">
          <img src={logo.src} alt="" width="2000" height="2000" />
        </span>
      </a>

      <nav class="navbar__links" aria-label={t(locale, "nav.primary")}>
        {
          links.map((link) => (
            <a
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={["navbar__link", { "navbar__link--active": isActive(link.href) }]}
              href={link.href}
            >
              <Fragment set:html={link.icon} />
              <span>{t(locale, link.key)}</span>
            </a>
          ))
        }
      </nav>

      <div class="navbar__actions">
        <div class="navbar__lang-wrap">
          <button
            aria-controls="lang-dropdown"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-label={t(locale, "lang.switch")}
            class="navbar__language"
            id="lang-toggle"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" />
              <path d="M3.8 12h16.4M12 3.5c2.1 2.3 3.2 5.1 3.2 8.5S14.1 18.2 12 20.5C9.9 18.2 8.8 15.4 8.8 12S9.9 5.8 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            <span>{LOCALE_NATIVE_NAMES[locale]}</span>
            <svg class="navbar__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="navbar__dropdown" id="lang-dropdown" role="listbox" aria-label={t(locale, "lang.switch")}>
            {
              locales.map((language) => (
                <li role="none">
                  <a
                    aria-selected={language === locale ? "true" : "false"}
                    class:list={["navbar__dropdown-item", { "navbar__dropdown-item--active": language === locale }]}
                    href={localizedPath(language, path)}
                    hreflang={language}
                    lang={language}
                    role="option"
                  >
                    <span>{LOCALE_NATIVE_NAMES[language]}</span>
                    {
                      language === locale && (
                        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="m3.5 8 2.7 2.7 6.3-6.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      )
                    }
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <a class="navbar__app-link" href={appUrl}>
          <span>{t(locale, "nav.accessApp")}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <button
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t(locale, "nav.openMenu")}
        class="navbar__menu-toggle"
        data-close-label={t(locale, "nav.closeMenu")}
        data-open-label={t(locale, "nav.openMenu")}
        id="hamburger"
        type="button"
      >
        <svg class="navbar__menu-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="navbar__mobile" id="mobile-menu" hidden>
      <nav aria-label={t(locale, "nav.primary")}>
        {
          links.map((link) => (
            <a
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={["navbar__mobile-link", { "navbar__mobile-link--active": isActive(link.href) }]}
              href={link.href}
            >
              <Fragment set:html={link.icon} />
              <span>{t(locale, link.key)}</span>
            </a>
          ))
        }
        <details class="navbar__mobile-languages">
          <summary>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" /><path d="M3.8 12h16.4M12 3.5c2.1 2.3 3.2 5.1 3.2 8.5S14.1 18.2 12 20.5C9.9 18.2 8.8 15.4 8.8 12S9.9 5.8 12 3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
            <span>{t(locale, "lang.switch")}</span>
            <span class="navbar__mobile-language-current">{LOCALE_NATIVE_NAMES[locale]}</span>
          </summary>
          <div>
            {
              locales.map((language) => (
                <a
                  aria-current={language === locale ? "true" : undefined}
                  class:list={["navbar__mobile-locale", { "navbar__mobile-locale--active": language === locale }]}
                  href={localizedPath(language, path)}
                  hreflang={language}
                  lang={language}
                >
                  {LOCALE_NATIVE_NAMES[language]}
                </a>
              ))
            }
          </div>
        </details>
        <a class="navbar__mobile-app-link" href={appUrl}>
          <span>{t(locale, "nav.accessApp")}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  const langToggle = document.getElementById("lang-toggle");
  const langDropdown = document.getElementById("lang-dropdown");

  if (navbar && hamburger && mobileMenu && langToggle && langDropdown) {
    const closeMobileMenu = () => {
      mobileMenu.hidden = true;
      hamburger.setAttribute("aria-expanded", "false");
      hamburger.setAttribute("aria-label", hamburger.dataset.openLabel ?? "");
      document.body.style.overflow = "";
    };

    const closeLanguageMenu = () => {
      langDropdown.classList.remove("navbar__dropdown--open");
      langToggle.setAttribute("aria-expanded", "false");
    };

    window.addEventListener(
      "scroll",
      () => navbar.classList.toggle("navbar--scrolled", window.scrollY > 20),
      { passive: true },
    );

    hamburger.addEventListener("click", () => {
      const isOpening = mobileMenu.hidden;
      mobileMenu.hidden = !isOpening;
      hamburger.setAttribute("aria-expanded", String(isOpening));
      hamburger.setAttribute("aria-label", isOpening ? (hamburger.dataset.closeLabel ?? "") : (hamburger.dataset.openLabel ?? ""));
      document.body.style.overflow = isOpening ? "hidden" : "";
      closeLanguageMenu();
    });

    langToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpening = !langDropdown.classList.contains("navbar__dropdown--open");
      langDropdown.classList.toggle("navbar__dropdown--open", isOpening);
      langToggle.setAttribute("aria-expanded", String(isOpening));
    });

    document.addEventListener("click", closeLanguageMenu);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMobileMenu();
        closeLanguageMenu();
      }
    });
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.9rem 1rem;
    background: linear-gradient(to bottom, rgba(9, 13, 26, 0.94), rgba(9, 13, 26, 0));
    transition: padding 180ms ease;
  }

  .navbar__shell {
    max-width: 74rem;
    margin: 0 auto;
    border: 1px solid rgba(226, 232, 240, 0.07);
    border-radius: 1.5rem;
    background: rgba(20, 28, 51, 0.88);
    box-shadow:
      14px 14px 28px rgba(0, 0, 0, 0.38),
      -8px -8px 20px rgba(255, 255, 255, 0.025),
      inset 1px 1px 0 rgba(255, 255, 255, 0.035),
      inset -1px -1px 0 rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .navbar--scrolled {
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  .navbar--scrolled .navbar__shell {
    border-color: rgba(67, 126, 247, 0.22);
    box-shadow:
      10px 10px 22px rgba(0, 0, 0, 0.42),
      -6px -6px 16px rgba(255, 255, 255, 0.025),
      inset 1px 1px 0 rgba(255, 255, 255, 0.045);
  }

  .navbar__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.45rem;
    padding: 0.55rem 0.65rem 0.55rem 1rem;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    min-width: 8.9rem;
    color: var(--somnus-color-text);
    text-decoration: none;
  }

  .navbar__brand-wordmark {
    display: block;
    width: 8.9rem;
    height: 2.25rem;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .navbar__brand img {
    display: block;
    width: 8.9rem;
    max-width: none;
    height: auto;
    transform: translateY(-3.1rem);
  }

  .navbar__links {
    display: none;
    align-items: stretch;
    justify-self: center;
    padding: 0.3rem;
    border-radius: 1.05rem;
    background: rgba(9, 13, 26, 0.58);
    box-shadow:
      inset 3px 3px 7px rgba(0, 0, 0, 0.32),
      inset -2px -2px 5px rgba(255, 255, 255, 0.025);
  }

  .navbar__link {
    display: inline-flex;
    min-width: 4.85rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.16rem;
    min-height: 3.25rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.8rem;
    color: var(--somnus-color-muted);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 160ms ease, box-shadow 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .navbar__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .navbar__link:hover {
    color: var(--somnus-color-text);
    background: rgba(255, 255, 255, 0.035);
  }

  .navbar__link--active {
    color: #f8fbff;
    background: linear-gradient(145deg, #4c87f7, #3368d9);
    box-shadow:
      4px 4px 9px rgba(0, 0, 0, 0.36),
      -2px -2px 5px rgba(111, 159, 255, 0.28),
      inset 1px 1px 0 rgba(255, 255, 255, 0.2);
  }

  .navbar__link--active:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .navbar__actions {
    display: none;
    align-items: center;
    gap: 0.65rem;
  }

  .navbar__lang-wrap {
    position: relative;
  }

  .navbar__language,
  .navbar__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(226, 232, 240, 0.07);
    border-radius: 0.78rem;
    background: var(--somnus-color-surface);
    color: var(--somnus-color-text);
    box-shadow:
      4px 4px 9px rgba(0, 0, 0, 0.35),
      -3px -3px 7px rgba(255, 255, 255, 0.028),
      inset 1px 1px 0 rgba(255, 255, 255, 0.028);
    cursor: pointer;
    transition: box-shadow 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .navbar__language:hover,
  .navbar__menu-toggle:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .navbar__language:active,
  .navbar__menu-toggle:active {
    box-shadow:
      inset 3px 3px 7px rgba(0, 0, 0, 0.36),
      inset -2px -2px 5px rgba(255, 255, 255, 0.025);
    transform: translateY(0);
  }

  .navbar__language {
    gap: 0.38rem;
    min-height: 2.65rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.76rem;
    font-weight: 650;
  }

  .navbar__language > :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--somnus-color-primary);
  }

  .navbar__language .navbar__chevron {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--somnus-color-muted);
    transition: transform 160ms ease;
  }

  .navbar__language[aria-expanded="true"] .navbar__chevron {
    transform: rotate(180deg);
  }

  .navbar__dropdown {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    display: none;
    width: 10.8rem;
    margin: 0;
    padding: 0.38rem;
    border: 1px solid rgba(226, 232, 240, 0.08);
    border-radius: 0.95rem;
    background: #141c33;
    box-shadow:
      10px 12px 20px rgba(0, 0, 0, 0.42),
      -4px -4px 10px rgba(255, 255, 255, 0.025);
    list-style: none;
  }

  .navbar__dropdown--open {
    display: block;
  }

  .navbar__dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.35rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.62rem;
    color: var(--somnus-color-text);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .navbar__dropdown-item:hover,
  .navbar__dropdown-item--active {
    background: rgba(67, 126, 247, 0.13);
    color: #aecaFF;
  }

  .navbar__dropdown-item :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .navbar__app-link,
  .navbar__mobile-app-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-height: 2.65rem;
    padding: 0.46rem 0.75rem;
    border-radius: 0.8rem;
    background: linear-gradient(145deg, #528cff, #356bdc);
    color: #fff;
    box-shadow:
      5px 5px 10px rgba(0, 0, 0, 0.38),
      -3px -3px 7px rgba(92, 146, 255, 0.24),
      inset 1px 1px 0 rgba(255, 255, 255, 0.2);
    font-size: 0.77rem;
    font-weight: 700;
    text-decoration: none;
    transition: box-shadow 160ms ease, transform 160ms ease;
  }

  .navbar__app-link:hover,
  .navbar__mobile-app-link:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .navbar__app-link :global(svg),
  .navbar__mobile-app-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .navbar__menu-toggle {
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
  }

  .navbar__menu-icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .navbar__mobile {
    border-top: 1px solid rgba(226, 232, 240, 0.06);
  }

  .navbar__mobile[hidden] {
    display: none;
  }

  .navbar__mobile nav {
    display: grid;
    gap: 0.45rem;
    padding: 0.75rem;
  }

  .navbar__mobile-link,
  .navbar__mobile-languages summary {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.58rem 0.72rem;
    border: 1px solid rgba(226, 232, 240, 0.05);
    border-radius: 0.78rem;
    background: rgba(9, 13, 26, 0.43);
    color: var(--somnus-color-text);
    box-shadow:
      inset 2px 2px 5px rgba(0, 0, 0, 0.26),
      inset -1px -1px 3px rgba(255, 255, 255, 0.02);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .navbar__mobile-link :global(svg),
  .navbar__mobile-languages summary :global(svg) {
    width: 1.18rem;
    height: 1.18rem;
    margin-right: 0.7rem;
    color: var(--somnus-color-primary);
  }

  .navbar__mobile-link--active {
    border-color: rgba(67, 126, 247, 0.42);
    background: rgba(67, 126, 247, 0.16);
    color: #dce8ff;
  }

  .navbar__mobile-languages summary {
    cursor: pointer;
    list-style: none;
  }

  .navbar__mobile-languages summary::-webkit-details-marker {
    display: none;
  }

  .navbar__mobile-language-current {
    margin-left: auto;
    color: var(--somnus-color-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .navbar__mobile-languages > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 0.45rem 0.1rem 0.05rem;
  }

  .navbar__mobile-locale {
    padding: 0.48rem;
    border-radius: 0.58rem;
    color: var(--somnus-color-muted);
    font-size: 0.78rem;
    font-weight: 650;
    text-align: center;
    text-decoration: none;
  }

  .navbar__mobile-locale--active {
    background: rgba(67, 126, 247, 0.14);
    color: #aecaff;
  }

  .navbar__mobile-app-link {
    min-height: 3.1rem;
    margin-top: 0.2rem;
    font-size: 0.88rem;
  }

  @media (max-width: 719px) {
    .navbar {
      padding: 0.5rem 0.6rem;
    }

    .navbar__shell {
      border-radius: 1rem;
      width: fit-content;
      max-width: none;
    }

    .navbar__inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 3.2rem;
      padding: 0.35rem 0.45rem 0.35rem 0.65rem;
      gap: 0.5rem;
    }

    .navbar__brand,
    .navbar__brand-wordmark {
      min-width: 6.8rem;
      width: 6.8rem;
    }

    .navbar__brand-wordmark {
      height: 1.7rem;
    }

    .navbar__brand img {
      width: 6.8rem;
      transform: translateY(-2.35rem);
    }

    .navbar__menu-toggle {
      width: 2.2rem;
      height: 2.2rem;
    }

    .navbar__menu-icon {
      width: 1rem;
      height: 1rem;
    }

    .navbar__mobile {
      position: fixed;
      z-index: 60;
      top: 4.25rem;
      left: 50%;
      width: min(calc(100vw - 1.2rem), 21rem);
      overflow: hidden;
      border: 1px solid rgba(226, 232, 240, 0.1);
      border-radius: 1rem;
      background: #141c33;
      box-shadow:
        14px 16px 30px rgba(0, 0, 0, 0.5),
        -6px -6px 15px rgba(255, 255, 255, 0.025),
        inset 1px 1px 0 rgba(255, 255, 255, 0.035);
      transform: translateX(-50%);
    }
  }

  @media (min-width: 720px) {
    .navbar__links,
    .navbar__actions {
      display: flex;
    }

    .navbar__menu-toggle,
    .navbar__mobile {
      display: none;
    }
  }

  @media (min-width: 1040px) {
    .navbar__inner {
      padding-right: 0.8rem;
      padding-left: 1.2rem;
    }

    .navbar__brand,
    .navbar__brand-wordmark {
      min-width: 10.25rem;
      width: 10.25rem;
    }

    .navbar__brand-wordmark {
      height: 2.45rem;
    }

    .navbar__brand img {
      width: 10.25rem;
      transform: translateY(-3.55rem);
    }

    .navbar__link {
      min-width: 5.25rem;
      padding-right: 0.82rem;
      padding-left: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar__shell,
    .navbar__link,
    .navbar__language,
    .navbar__menu-toggle,
    .navbar__app-link,
    .navbar__mobile-app-link {
      transition: none;
    }
  }
</style>

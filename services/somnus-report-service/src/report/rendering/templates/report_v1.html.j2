<!doctype html>
<html lang="{{ request.locale }}">
  <head>
    <meta charset="utf-8" />
    <title>{{ strings.brand }} · {{ strings.title }}</title>
    <style>
      /* The Somnus palette: night navy, surface, brand blue. Level colours are
         the clinical artifact's own (L0 red ... L4 blue). */
      @page {
        size: A4;
        margin: 16mm 16mm 20mm;
        @bottom-left { content: "{{ strings.brand }} · The Somnus"; font-size: 7.5pt; color: #64748b; }
        @bottom-right { content: "{{ strings.page }} " counter(page) " / " counter(pages); font-size: 7.5pt; color: #64748b; }
      }
      body { font-family: "DejaVu Sans", sans-serif; font-size: 10pt; color: #1e293b; line-height: 1.5; margin: 0; }
      .report-header { background: #090d1a; color: #e2e8f0; border-radius: 10pt; padding: 16pt 18pt 14pt; margin-bottom: 14pt; }
      .brand { font-size: 24pt; font-weight: bold; color: #ffffff; margin: 0; letter-spacing: 0.6pt; }
      .brand-dot { color: #437ef7; }
      .byline { margin: 1pt 0 10pt; color: #9fb0c3; font-size: 9.5pt; }
      h1 { font-size: 13.5pt; margin: 0; color: #ffffff; font-weight: normal; }
      .report-date { color: #9fb0c3; margin: 4pt 0 0; font-size: 9pt; }
      h2 { font-size: 11.5pt; color: #2f6ae0; margin: 0 0 6pt; padding-left: 7pt; border-left: 3pt solid #437ef7; }
      section { margin: 0 0 12pt; page-break-inside: avoid; }
      section p { margin: 0 0 5pt; }
      ul { margin: 0; padding-left: 14pt; }
      li { margin: 0 0 4pt; }
      li::marker { color: #437ef7; }
      .level-card { border-radius: 8pt; padding: 11pt 13pt; border: 1pt solid #cbd5e1; border-left: 5pt solid #437ef7; background: #f1f5ff; }
      .level-card h2 { border: 0; padding: 0; color: #334155; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.6pt; }
      .level-name { font-size: 14pt; font-weight: bold; margin: 0 0 4pt; color: #0f172a; }
      .urgent { font-weight: bold; color: #0f172a; }
      .framing { color: #475569; font-size: 9pt; }
      .level-L0 { border-left-color: #dc2626; background: #fef2f2; }
      .level-L1 { border-left-color: #ea580c; background: #fff7ed; }
      .level-L2 { border-left-color: #d97706; background: #fffbeb; }
      .level-L3 { border-left-color: #0d9488; background: #f0fdfa; }
      .level-L4 { border-left-color: #2563eb; background: #eff6ff; }
      .emergency-note { font-weight: bold; color: #b91c1c; }
      .what-to-do { background: #141c33; color: #e2e8f0; border-radius: 8pt; padding: 11pt 13pt; }
      .what-to-do h2 { color: #ffffff; border-left-color: #437ef7; }
      .what-to-do li::marker { color: #9fb0c3; }
      .patterns strong { color: #0f172a; }
      .limits { border-top: 1pt solid #e2e8f0; padding-top: 8pt; color: #475569; font-size: 9pt; }
      .limits h2 { color: #475569; border-left-color: #94a3b8; font-size: 10pt; }
      .report-footer { margin-top: 10pt; font-size: 7.5pt; color: #94a3b8; }
    </style>
  </head>
  <body>
    <header class="report-header">
      <p class="brand">{{ strings.brand }}<span class="brand-dot">.</span></p>
      <p class="byline">{{ strings.byline }}</p>
      <h1>{{ strings.title }}</h1>
      <p class="report-date"><span class="date-label">{{ strings.date }}:</span> <span class="completed-at">{{ completed_display }}</span></p>
    </header>
    {% if is_emergency %}
    <section class="care-level emergency" role="alert">
      <div class="level-card level-L0">
      <h2>{{ strings.careLevel }}</h2>
      <p class="emergency-note">{{ strings.emergency }}</p>
      {% if level %}
      <p class="level-name">{{ level.name }}</p>
      {% endif %}
      {% for message in urgent %}
      <p class="urgent">{{ message }}</p>
      {% else %}
      <p class="urgent">{{ strings.emergencyNow }}</p>
      {% endfor %}
      </div>
    </section>
    {% elif narrative %}
    {#- The person's AI-written report (§15 amended 2026-10-16). The level and
        the fired rules' messages stay the protocol's words; the AI text only
        explains and recommends around them. -#}
    <section class="summary">
      <h2>{{ strings.summary }}</h2>
      <p>{{ narrative.summary }}</p>
    </section>
    {% if level %}
    <section class="care-level">
      <div class="level-card{% if level %} level-{{ level.id }}{% endif %}">
      <h2>{{ strings.careLevel }}</h2>
      {% if show_framing %}
      <p class="framing">{{ strings.framing }}</p>
      {% endif %}
      <p class="level-name">{{ level.name }}</p>
      {% for message in urgent %}
      <p class="urgent">{{ message }}</p>
      {% endfor %}
      </div>
    </section>
    {% endif %}
    <section class="what-to-do">
      <h2>{{ strings.whatToDo }}</h2>
      <ul>
        {% for step in narrative.what_to_do %}
        <li>{{ step }}</li>
        {% endfor %}
      </ul>
    </section>
    {% if narrative.patterns %}
    <section class="patterns">
      <h2>{{ strings.patterns }}</h2>
      <ul>
        {% for pattern in narrative.patterns %}
        <li><strong>{{ pattern.name }}</strong>: {{ pattern.why }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% if narrative.recommendations %}
    <section class="recommendations">
      <h2>{{ strings.recommendations }}</h2>
      <ul>
        {% for item in narrative.recommendations %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% if narrative.prepare %}
    <section class="prepare">
      <h2>{{ strings.prepare }}</h2>
      <ul>
        {% for item in narrative.prepare %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% else %}
    <section class="summary">
      <h2>{{ strings.summary }}</h2>
      <ul>
        {% for module in routed %}
        <li>{{ module.output }}</li>
        {% endfor %}
      </ul>
    </section>
    {% if level %}
    <section class="care-level">
      <div class="level-card{% if level %} level-{{ level.id }}{% endif %}">
      <h2>{{ strings.careLevel }}</h2>
      {% if show_framing %}
      <p class="framing">{{ strings.framing }}</p>
      {% endif %}
      <p class="level-name">{{ level.name }}</p>
      <p class="level-action">{{ level.action }}</p>
      </div>
    </section>
    {% endif %}
    {% if routed %}
    <section class="patterns">
      <h2>{{ strings.patterns }}</h2>
      <ul>
        {% for module in routed %}
        <li>{{ module.name }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    <section class="unknown">
      <h2>{{ strings.unknown }}</h2>
      <p>{{ strings.unknownText }}</p>
    </section>
    {% if routed %}
    <section class="prepare">
      <h2>{{ strings.prepare }}</h2>
      <ul>
        {% for module in routed %}
        {% for question in module.minimum_questions %}
        <li>{{ question }}</li>
        {% endfor %}
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% if citations %}
    <section class="sources">
      <h2>{{ strings.sources }}</h2>
      <ul>
        {% for citation in citations %}
        <li class="source" data-source-id="{{ citation.source_id }}">{{ citation.citation }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {#- Addendum B §B3.1: supporting material from the reference corpus. A
        separate section on purpose. The block above is what the fired rule
        cited; this one is background an admin published, and conflating the two
        would attribute a clinical decision to material no rule named. -#}
    {% if grounding %}
    <section class="supporting-material">
      <h2>{{ strings.supportingMaterial }}</h2>
      <ul>
        {% for material in grounding %}
        <li class="material" data-document-id="{{ material.document_id }}"
            data-scope="{{ material.matched_scope_type }}:{{ material.matched_scope_key }}">{{ material.citation }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
    {% endif %}
    <section class="limits">
      <h2>{{ strings.limits }}</h2>
      {% for sentence in limits_text %}
      <p>{{ sentence }}</p>
      {% endfor %}
    </section>
    <footer class="report-footer">
      {{ strings.reference }}: <span class="assessment-id">{{ request.assessment_id }}</span>
      · <span class="versions">{{ template_version }} / {{ request.definition_version }} / {{ request.content_version }}</span>
      · <span class="completed-stamp">{{ request.completed_at }}</span>
    </footer>
  </body>
</html>

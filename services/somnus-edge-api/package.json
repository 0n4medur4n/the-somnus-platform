{
  "name": "@somnus/edge-api",
  "version": "0.0.0",
  "private": true,
  "description": "The Somnus edge API. Cloud Run, public BFF: Firebase token verification, server-side session cookies, CSRF, CORS, rate limiting, composition. No TiDB connection (build plan §5.3).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run --config test/vitest.config.ts",
    "test:watch": "vitest --config test/vitest.config.ts",
    "test:coverage": "vitest run --config test/vitest.config.ts --coverage",
    "generate:openapi": "node --import @swc-node/register/esm-register scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "8.0.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@somnus/api-contracts": "workspace:*",
    "@somnus/cloud-run-client": "workspace:*",
    "@somnus/config": "workspace:*",
    "@somnus/errors": "workspace:*",
    "@somnus/observability": "workspace:*",
    "fastify": "5.10.0",
    "firebase-admin": "14.2.0",
    "nestjs-zod": "5.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@somnus/tsconfig": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.10"
  }
}
